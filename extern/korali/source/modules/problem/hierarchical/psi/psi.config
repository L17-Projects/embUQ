{

  "Module Data":
  {
    "Class Name": "Psi",
    "Namespace": ["korali", "problem", "hierarchical"],
    "Parent Class Name": "Hierarchical"
  },

 "Configuration Settings":
 [
   {
    "Name": [ "Use Batch Evaluation" ],
    "Type": "int",
    "Description": "Enables the optional batched likelihood path for Hierarchical/Psi problems."
   },
   {
    "Name": [ "Batch Evaluation Backend" ],
    "Type": "std::string",
    "Options": [
                { "Value": "External", "Description": "Dispatches batched Psi log-likelihood evaluation to an external callback." },
                { "Value": "NativeCpu", "Description": "Runs the batched Psi log-likelihood natively in Korali on the CPU." },
                { "Value": "NativeCuda", "Description": "Runs the batched Psi log-likelihood natively in Korali on a CUDA GPU." }
               ],
    "Description": "Selects the backend used when batched Hierarchical/Psi evaluation is enabled."
   },
   {
    "Name": [ "Sub Experiments" ],
    "Type": "std::vector<knlohmann::json>",
    "Description": "Provides results from previous Bayesian Inference sampling experiments."
   },
   {
    "Name": [ "Conditional Priors" ],
    "Type": "std::vector<std::string>",
    "Description": "List of conditional priors to use in the hierarchical problem."
   }
 ],

 "Internal Settings":
 [
   {
    "Name": [ "Batch Computational Model" ],
    "Type": "std::uint64_t",
    "Description": "Optional Python callback used to evaluate a batch of Psi log-likelihoods."
   }
 ],

 "Module Defaults":
 {
  "Use Batch Evaluation": false,
  "Batch Evaluation Backend": "External",
  "Batch Computational Model": 0
 }
}
